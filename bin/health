#!/usr/bin/env bash
# Health check: database, backend HTTP, public API. Exit non-zero on failure.
set -euo pipefail
# shellcheck disable=SC1091
source "$(dirname "$0")/common.sh"
fail=0

if pg_isready -h "$PG_SOCKET_DIR" -p "$PG_PORT" -q 2>/dev/null; then
  echo "OK   postgres :$PG_PORT"
else
  echo "FAIL postgres :$PG_PORT (run bin/db)"; fail=1
fi

code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://localhost:4000/ || true)"
if [ "$code" = "200" ]; then echo "OK   backend  :4000 (landing $code)"; else echo "FAIL backend  :4000 (got $code)"; fail=1; fi

cats="$(curl -s --max-time 5 http://localhost:4000/api/v1/categories || true)"
if echo "$cats" | grep -q '"key"'; then echo "OK   categories endpoint"; else echo "FAIL categories endpoint: $cats"; fail=1; fi

exit "$fail"
