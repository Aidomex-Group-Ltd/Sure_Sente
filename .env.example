# Copy backend/.env from these placeholders (generate secrets with openssl, see below). Placeholders only.
# Database (local instance used in development)
DATABASE_URL="ecto://sure_sente:change-me@127.0.0.1:5434/sure_sente_dev"
# Phoenix
SECRET_KEY_BASE=change-me-generate-with-openssl-rand-base64-64
PORT=4000
# Reserved / future use (generated, wired where applicable)
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64
LIVE_SIGNING_SALT=change-me-generate-with-openssl-rand-base64-32
# Demo seed data (labelled [DEMO], dev only)
SEED_DEMO=true
# Adapters (unconfigured in pilot: mock log only, no real SMS/payments)
SMS_PROVIDER=mock
SMS_API_KEY=
PAYMENT_PROVIDER=disabled
STORAGE_BACKEND=local
STORAGE_DIR=./priv/uploads
# Frontend
VITE_API_URL=http://localhost:4000/api/v1

# Generate secrets:
#   openssl rand -base64 64   # SECRET_KEY_BASE, JWT_SECRET
#   openssl rand -base64 32   # LIVE_SIGNING_SALT
# Launch backend:
#   cd backend && set -a; source .env; set +a; mix phx.server
